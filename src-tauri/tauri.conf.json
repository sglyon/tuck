{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuck",
  "version": "0.1.0",
  "identifier": "com.sglyon.tuck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tuck",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#f5f6f8"
      },
      {
        "label": "dictation-overlay",
        "title": "Tuck dictation",
        "url": "index.html?dictation-overlay",
        "width": 320,
        "height": 76,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "backgroundColor": "#003DA5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; media-src tuck-audio: http://tuck-audio.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "binaries/native/": "binaries/",
      "../assets/licenses/": "licenses/",
      "../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
