  "narrative": {
    "northStar": "The Cool Porcelain Meeting Desk",
    "overview": "Tuck is a meeting desk: a library, a document, and an assistant beside the conversation. Cool porcelain surfaces, flat seams, ink text, and cornflower actions give busy professionals a quiet place to capture a call and recover its evidence. System typography and familiar controls make the work readable before exposing model or connection details.",
    "keyCharacteristics": [
      "Flat split panes with independent scrolling.",
      "Reading-first document hierarchy and restrained functional color.",
      "Timestamp citations return to spoken evidence.",
      "Plain-language setup with engineering details disclosed progressively."
    ],
    "rules": [
      {
        "name": "Functional Accent",
        "body": "Reserve cornflower for actions, selection, focus, and source navigation; use text and icons alongside status colors.",
        "section": "colors"
      },
      {
        "name": "Readable Supporting Text",
        "body": "Preserve the final cascade: functional timestamp/source labels are 12px, context/tab counts are 11px, and model-readiness/shortcut text is 12px in the final dark blue gray. Small supplementary metadata remains a review limitation, not a new default.",
        "section": "typography"
      },
      {
        "name": "Seams Before Shadows",
        "body": "Separate persistent panes through background tones and one-pixel seams; reserve shadows for floating menus, notifications, and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the library, document, and assistant hierarchy legible at every breakpoint.",
      "Do keep essential supporting text readable against its actual surface and preserve the final functional microtext overrides.",
      "Do show saving, failure, retry, capture, and processing states truthfully.",
      "Do disclose hosted transcript processing beside the recap action and assistant composer.",
      "Do retain pending notes, ordered writes, and close protection when changing the editor."
    ],
    "donts": [
      "Don't treat example content, a configured provider label, or a navigable timestamp as proof of live inference or factual grounding.",
      "Don't expose raw model IDs, CPU controls, connection URLs, or audio backend names as basic setup choices.",
      "Don't replace flat pane seams with a dashboard of floating cards or decorative shadows.",
      "Don't infer native capture, hardware performance, or hosted-service reliability from browser screenshots."
    ]
  }
}
